#!/usr/bin/env bash
# Copy this machine's Codex ChatGPT login (~/.codex/auth.json, with access and refresh token)
# into the personal Amp secret CODEX_AUTH_JSON of every Amp account saved in the CLI. Orbs then get it as an env var, and codex and pi
# can use your ChatGPT subscription there (tandem reads it; any other tool can too).
#
# When the access token has less than 40 h left, this script first runs one tiny `codex exec`
# so that Codex refreshes the login here, then uploads the new file.
#
# Usage:  sync-codex-auth            sync now (uploads only when auth.json changed)
#         sync-codex-auth --install  also run it daily with launchd (macOS)
#         sync-codex-auth --uninstall
# Needs: codex logged in with ChatGPT (`codex login`), amp CLI logged in, python3.
set -euo pipefail

LABEL=dev.tandem.sync-codex-auth
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
SELF="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
CACHE="$HOME/.cache/tandem"; mkdir -p "$CACHE"
AUTH="${CODEX_HOME:-$HOME/.codex}/auth.json"

case "${1:-}" in
  --install)
    mkdir -p "$(dirname "$PLIST")"
    cat > "$PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>$LABEL</string>
  <key>ProgramArguments</key><array><string>$SELF</string></array>
  <key>EnvironmentVariables</key><dict><key>PATH</key><string>$PATH</string></dict>
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>$CACHE/sync.log</string>
  <key>StandardErrorPath</key><string>$CACHE/sync.log</string>
</dict></plist>
EOF
    launchctl bootout "gui/$(id -u)/$LABEL" 2>/dev/null || true
    launchctl bootstrap "gui/$(id -u)" "$PLIST"
    echo "Installed $PLIST (daily 09:00 and at login). Log: $CACHE/sync.log"
    exit 0 ;;
  --uninstall)
    launchctl bootout "gui/$(id -u)/$LABEL" 2>/dev/null || true
    rm -f "$PLIST"; echo "Removed $LABEL."; exit 0 ;;
esac

hours_left() {
  python3 -I - "$AUTH" <<'PY'
import base64, json, sys, time
a = json.load(open(sys.argv[1]))
if a.get("auth_mode") != "chatgpt":
    sys.exit("codex is not logged in with ChatGPT (auth_mode=%s). Run: codex login" % a.get("auth_mode"))
p = a["tokens"]["access_token"].split(".")[1]; p += "=" * (-len(p) % 4)
print(int((json.loads(base64.urlsafe_b64decode(p))["exp"] - time.time()) / 3600))
PY
}

[ -f "$AUTH" ] || { echo "No $AUTH. Run: codex login" >&2; exit 1; }
left=$(hours_left)
if [ "$left" -lt 40 ]; then
  echo "$(date '+%F %T') token has ${left} h left, letting codex refresh it"
  tmp=$(mktemp -d); (cd "$tmp" && codex exec --skip-git-repo-check -c model_reasoning_effort=low "Reply with OK" </dev/null >/dev/null 2>&1) || true; rm -rf "$tmp"
  left=$(hours_left)
fi

payload=$(python3 -I -c 'import json,sys; print(json.dumps(json.load(open(sys.argv[1])), separators=(",", ":")))' "$AUTH")
sum=$(printf %s "$payload" | shasum -a 256 | cut -d' ' -f1)

# Upload to every Amp account saved in the CLI, then restore the active one.
accounts=$(amp account list | sed -E 's/^[* ] +//; s/ \(.*//')
active=$(amp account list | sed -nE '/^\*/{s/^\* +//; s/ \(.*//; p;}')
trap '[ -n "$active" ] && amp account switch "$active" >/dev/null' EXIT
for acct in $accounts; do
  shafile="$CACHE/codex-auth.$acct.sha"
  if [ "$sum" = "$(cat "$shafile" 2>/dev/null)" ]; then
    echo "$(date '+%F %T') $acct: unchanged, ${left} h left"; continue
  fi
  amp account switch "$acct" >/dev/null
  printf %s "$payload" | amp secrets set CODEX_AUTH_JSON --user --secret --data-file - >/dev/null
  echo "$sum" > "$shafile"
  echo "$(date '+%F %T') $acct: uploaded CODEX_AUTH_JSON, ${left} h left"
done
